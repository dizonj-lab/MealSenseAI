# MealSenseAI configuration (Docker Compose). Copy to .env; ./scripts/start.sh does this and sets JWT_SECRET.
# No value here is required for the core workflow; there are no external API keys.

# Web app port and bind address (127.0.0.1 = this computer only, 0.0.0.0 = also phones on your network)
HTTP_PORT=8080
HTTP_BIND=0.0.0.0

# Secrets: change before first start. Never commit .env.
JWT_SECRET=replace-with-a-long-random-string
POSTGRES_PASSWORD=mealsense

# Inference device for the food classifier: auto (CUDA if available, else CPU) | cpu | cuda
INFERENCE_DEVICE=auto

# Optional cache (start with: docker compose --profile cache up -d)
# REDIS_URL=redis://redis:6379/0

# Optional local SLM for explanations (start with: docker compose --profile slm up -d)
# OLLAMA_URL=http://ollama:11434
# OLLAMA_MODEL=
# OLLAMA_PULL_MODEL=qwen2.5:1.5b

# Home-server hosting only (see 08-Deployment/HOME-SERVER.md)
# CLOUDFLARE_TUNNEL_TOKEN=
# COMPOSE_FILE=docker-compose.yml:docker-compose.home.yml
# APP_CPUS=8
